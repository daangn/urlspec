{
  "name": "@urlspec/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A type-safe, declarative language for defining and documenting URL structures in web applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/daangn/urlspec.git"
  },
  "license": "MIT",
  "author": "Danggeun Market Inc.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "ultra -r build",
